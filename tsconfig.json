{
  "compilerOptions": {
    "target": "ES2020",
    "allowImportingTsExtensions": true,
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["agent/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
